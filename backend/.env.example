# Active model profile and commented alternatives: model_choices.env
VISION_PROVIDER=detector
DETECTOR_MODEL=yolo26s.pt
OCR_ROLE_MODEL=
BOOK_READER_MODEL=qwen2.5vl:3b
ROOM_DETECTOR_MODEL=library-room-yoloe26s-v2.pt
OLLAMA_URL=http://localhost:11434
VALIDATOR_DETECTOR_MODEL=yolo11s.pt

# Optional text-only catalogue/market lookup; never sends images.
ENABLE_CATALOGUE_LOOKUP=false
# eBay Browse API application access token (keep in backend/.env only).
EBAY_ACCESS_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US

# Retrieve source candidates during capture when a provider is configured.
ENABLE_LIVE_RESEARCH=false

# Only needed when serving the UI and API on different origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Contextual dialogue uses a separate Ollama text model.
# Install once: ollama pull qwen2.5:3b
CONVERSATION_MODEL=qwen2.5:3b

# Separate blind object-crop verification. Keep localization on YOLO.
# Install: ollama pull gemma3:latest (4B vision model).
CROP_VERIFIER_MODEL=gemma3:latest
CROP_VERIFIER_TIMEOUT_S=45
CROP_VERIFICATION_FRAME_BUDGET_S=90
