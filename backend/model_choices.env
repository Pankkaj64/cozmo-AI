# Local model profile. Loaded after backend/.env; shell variables and .env win.
# Restart the backend after changing anything here.

# Book boxes (primary) and an independent second detector for the count check.
DETECTOR_MODEL=yolo26s.pt
VALIDATOR_DETECTOR_MODEL=yolo11s.pt
# Open-vocabulary room categories (shelving, lamp, framed painting, rug, coffee machine ...).
# Built by tools/setup_detector.py from the prompts in app/perception/room_detector.py.
ROOM_DETECTOR_MODEL=library-room-yoloe26s-v2.pt

# Cross-platform OCR for spine crops: "paddle" (PaddleOCR) or "easyocr".
OCR_ENGINE=paddle
OCR_LANG=en

# Local vision-language models served by Ollama (http://localhost:11434).
#   ollama pull gemma3:latest  -> reads the visible title of each book crop (4B)
#   ollama pull qwen3-vl:2b    -> blind check of each crop's category (2B)
#   ollama pull qwen2.5:3b     -> spoken conversation with the claimant
OLLAMA_URL=http://localhost:11434
BOOK_READER_MODEL=gemma3:latest
CROP_VERIFIER_MODEL=qwen3-vl:2b
CROP_VERIFIER_TIMEOUT_S=45
CROP_VERIFICATION_FRAME_BUDGET_S=90
CONVERSATION_MODEL=qwen2.5:3b

# Notes from the model comparison on an 8 GB Apple-silicon laptop (docs/model-validation.md):
# - qwen2.5vl:3b cannot load (Metal needs a 6.6 GB buffer); with a 1k context it took 57-160 s
#   per crop. gemma3 4B reads titles in 7-10 s warm and is the reader.
# - qwen3-vl:2b is the verifier: 5-8 s per crop, agrees on real spines with named parts; it only
#   answers when the prompt ends with /no_think (its Ollama `think` flag is ignored).
# - gemma3 as verifier called stacked spines "table"/"uncertain"; moondream answered "bookshelf"
#   or "air conditioner" for books. Neither is used for the blind check.
# - yolo26m classified a black cover as a laptop and was not better than yolo26s here.
# - YOLOE "book" boxes (room detector) find 18-51 spines per shelf where COCO finds 1-17.
