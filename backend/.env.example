# Copy to backend/.env. Everything is optional: the app runs fully offline with local
# models; price sources are enabled when their credentials are present.
# Model names live in backend/model_choices.env (override any of them here).

# ---- OCR (cross-platform) ----------------------------------------------------------
# "paddle" = PaddleOCR (default). "easyocr" = EasyOCR (pip install easyocr).
OCR_ENGINE=paddle
OCR_LANG=en

# ---- Local models through Ollama ----------------------------------------------------
OLLAMA_URL=http://localhost:11434

# ---- Book and item price sources (never a language model) ---------------------------
# Google Books list prices for the claim country (works without a key; a key raises quota).
ENABLE_GOOGLE_BOOKS=true
GOOGLE_BOOKS_API_KEY=
# eBay Browse API: new (replacement) and used fixed-price listings. Either paste an
# application token, or give client credentials and the backend fetches tokens itself.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ACCESS_TOKEN=
EBAY_ENV=production          # or sandbox
EBAY_MARKETPLACE_ID=         # blank = choose from the claim country (EBAY_GB, EBAY_US ...)
# Open Library work/edition lookup for identified titles and visible ISBNs.
ENABLE_CATALOGUE_LOOKUP=true
# Run price research while the sweep is still in progress (also runs at finish).
ENABLE_LIVE_RESEARCH=false

# Endpoint overrides (defaults live in backend/app/config.py; set only to point at a proxy/sandbox).
# GOOGLE_BOOKS_URL=
# EBAY_API_URL=
# OPEN_LIBRARY_SEARCH_URL=
# OPEN_LIBRARY_BOOKS_URL=
# FX_PRIMARY_URL=
# FX_FALLBACK_URL=

# ---- Pricing rules --------------------------------------------------------------------
# Minimum title/author similarity (0-1) before a provider listing may be applied.
PRICING_MIN_MATCH=0.8
# Ebook list prices are not physical replacement cost unless you say so.
PRICING_ALLOW_EBOOK_PROXY=false
# Convert foreign quotes with dated ECB (Frankfurter) or ExchangeRate-API rates.
ENABLE_FX_CONVERSION=true
PRICING_RESEARCH_TIMEOUT_S=180

# ---- Transport --------------------------------------------------------------------------
# Only needed when the UI and API run on different origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
